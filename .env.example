# Local development defaults to SQLite and local media.
# For hosted persistence, set all three Supabase variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=postflow-media

# Deployment
APP_PASSWORD=
PUBLIC_BASE_URL=http://localhost:4173
PUBLISH_MODE=dry-run
SESSION_TTL_MS=43200000

# Add social provider credentials only after controlled testing.
IG_USER_ID=
IG_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
